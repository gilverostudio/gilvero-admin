# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" / "publishable" key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts only (db:seed, admin:create). NEVER expose to the browser or add to hosting.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (Session pooler, port 5432)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Website link ────────────────────────────────────────────────────────────
# The public site, used for "View site" links and cache refreshes after saves
NEXT_PUBLIC_WEBSITE_URL=https://gilvero.com
# Must match REVALIDATE_SECRET in the website's Netlify environment variables
WEBSITE_REVALIDATE_SECRET=
